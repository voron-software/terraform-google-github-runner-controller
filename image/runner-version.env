# The Actions runner release baked into the image, and the digest its tarball must have. Plain KEY=VALUE lines with no quotes, so
# that a shell can source the file and sed can read it.
#
# crates/controller/runner.sh pins the same two values, because it is embedded in the controller binary and runs on a bare VM,
# where it cannot read a sibling file. A test in crates/controller/tests/runner_pin.rs fails when the two disagree, so change both
# in one pull request (docs/operations/runner-version.md).
RUNNER_VERSION=2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40
